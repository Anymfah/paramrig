{
  "name": "paramrig",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --mode app",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node e2e/run.mjs",
    "build:web-sdk": "vite build --config vite.web-sdk.config.ts && node scripts/build-web-declarations.mjs && node scripts/check-web-sdk.mjs",
    "test:web-service": "node --experimental-strip-types --test services/web/server.test.mjs",
    "build:sdks": "node scripts/build-sdks.mjs",
    "test:sdks": "node scripts/test-sdk-consumers.mjs",
    "build:modules": "tsc -b && node scripts/build-modules.mjs",
    "build:catalog": "node scripts/generate-module-catalog.mjs && node scripts/generate-module-thumbnails.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@react-three/fiber": "^9.8.2",
    "fontkit": "^2.0.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.63.0",
    "opentype.js": "^2.0.0",
    "paper": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "postcss": "^8.5.26"
  },
  "workspaces": [
    "packages/*"
  ]
}
