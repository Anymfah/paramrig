{
  "name": "paramrig",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --mode app",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node e2e/run.mjs",
    "build:web-sdk": "vite build --config vite.web-sdk.config.ts && tsc -p tsconfig.web-sdk.json && node scripts/check-web-sdk.mjs",
    "test:web-service": "node --experimental-strip-types --test services/web/server.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@react-three/fiber": "^9.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.40.0",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.8.2",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.56.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
